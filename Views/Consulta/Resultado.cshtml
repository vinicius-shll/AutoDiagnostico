@model AutoDiagnostico.Models.ResultadoViewModel
@{
    ViewData["Title"] = "Resultado do diagnóstico";
    var cor = Model.Diagnostico?.Gravidade switch
    {
        "Alta" => "high",
        "Média" => "medium",
        "Baixa" => "low",
        _ => "unknown"
    };
}
<div class="ad-page-heading ad-result-heading" data-ad-reveal><div><p class="ad-eyebrow">SUA CONSULTA / NEO DRIVE</p><h1>Mais clareza.<br /><span class="ad-gradient-text">Seu próximo passo.</span></h1></div><a class="ad-button ad-button-secondary" asp-controller="Consulta" asp-action="Criar">Nova consulta <span aria-hidden="true">↗</span></a></div>
<section class="ad-context ad-panel" aria-labelledby="relato-title" data-ad-reveal><p class="ad-eyebrow" id="relato-title">O QUE VOCÊ RELATOU</p><p class="ad-user-text">@Model.Sintoma</p><div class="ad-location"><span aria-hidden="true">⌖</span> @Model.Endereco</div></section>
<section class="ad-section ad-analysis" aria-labelledby="analysis-title">
    <div class="ad-section-heading" data-ad-reveal><div><p class="ad-eyebrow">01 / ORIENTAÇÃO</p><h2 id="analysis-title">O que pode ser</h2></div><span class="ad-micro">ANÁLISE POR INTELIGÊNCIA ARTIFICIAL</span></div>
    @if (!string.IsNullOrEmpty(Model.AvisoDiagnostico))
    {
        <div class="ad-notice" role="alert"><strong>Não foi possível obter o diagnóstico.</strong><p>@Model.AvisoDiagnostico</p></div>
    }
    else if (Model.Diagnostico != null)
    {
        <div class="ad-diagnosis-grid">
            <article class="ad-panel ad-diagnosis" data-ad-reveal><p class="ad-eyebrow">RESUMO DA ANÁLISE</p><h3>Entendendo os sinais</h3><p class="ad-summary ad-user-text">@Model.Diagnostico.Resumo</p>
                @if (Model.Diagnostico.PossiveisCausas?.Count > 0)
                {
                    <h4 class="ad-small-title">Possíveis causas</h4><ul class="ad-causes">@foreach (var causa in Model.Diagnostico.PossiveisCausas) { <li>@causa</li> }</ul>
                }
                else
                {
                    <p class="ad-muted">Nenhuma causa específica foi informada nesta análise.</p>
                }
            </article>
            <aside class="ad-panel ad-severity ad-severity-@cor" data-ad-reveal aria-label="Gravidade e especialidade recomendada"><p class="ad-eyebrow">ATENÇÃO RECOMENDADA</p><span class="ad-severity-symbol" aria-hidden="true">!</span><h3>Gravidade <strong>@(string.IsNullOrWhiteSpace(Model.Diagnostico.Gravidade) ? "não informada" : Model.Diagnostico.Gravidade)</strong></h3><div class="ad-severity-track" aria-hidden="true"><i></i><i></i><i></i></div><div class="ad-specialty"><span>Especialidade recomendada</span><strong>@Model.Diagnostico.Especialidade</strong></div><p>Confirme a orientação e a gravidade com um mecânico.</p></aside>
        </div>
    }
    else
    {
        <div class="ad-notice" role="status"><strong>Diagnóstico indisponível no momento.</strong><p>Tente uma nova consulta. Você também pode procurar avaliação mecânica profissional.</p></div>
    }
    <p class="ad-disclaimer ad-align-left">Orientação gerada por inteligência artificial. Não substitui a avaliação de um mecânico profissional.</p>
</section>
<section class="ad-section ad-workshops" aria-labelledby="workshops-title">
    <div class="ad-section-heading" data-ad-reveal><div><p class="ad-eyebrow">02 / PERTO DE VOCÊ</p><h2 id="workshops-title">Encontre ajuda especializada.</h2><p>Oficinas perto de: @Model.Endereco</p></div></div>
    @if (!string.IsNullOrEmpty(Model.AvisoOficinas))
    {
        <div class="ad-notice" role="alert"><strong>A busca por oficinas não foi concluída.</strong><p>@Model.AvisoOficinas</p></div>
    }
    else if (Model.Oficinas == null || Model.Oficinas.Count == 0)
    {
        <div class="ad-panel ad-empty" role="status"><span class="ad-empty-symbol" aria-hidden="true">⌖</span><h3>Nenhuma oficina encontrada por aqui.</h3><p>Tente um endereço mais completo, com cidade, ou um CEP.</p><a class="ad-text-link" asp-controller="Consulta" asp-action="Criar">Consultar outro endereço →</a></div>
    }
    else
    {
        <div class="ad-workshop-grid">
            @foreach (var oficina in Model.Oficinas)
            {
                var distancia = "";
                if (oficina.DistanciaMetros != null)
                {
                    distancia = oficina.DistanciaMetros < 1000
                        ? $"{oficina.DistanciaMetros:0} m"
                        : $"{oficina.DistanciaMetros / 1000:0.0} km";
                }
                <article class="ad-panel ad-workshop @(oficina.Destaque ? "ad-workshop-highlight" : "")" data-ad-reveal>
                    <div class="ad-workshop-top"><span class="ad-workshop-icon" aria-hidden="true">⌖</span>@if (!string.IsNullOrEmpty(distancia)) { <span class="ad-distance">@distancia</span> }</div>
                    <h3>@oficina.Nome</h3><p>@oficina.Endereco</p>
                    @if (oficina.Destaque)
                    {
                        <span class="ad-match">Nome relacionado à especialidade</span><p class="ad-match-note">Correspondência por nome com @(Model.Diagnostico?.Especialidade ?? "serviços automotivos"). Confirme os serviços com a oficina; não é uma certificação.</p>
                    }
                    @{
                        var latitudeTexto = oficina.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var longitudeTexto = oficina.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
                        var linkMapa = "https://www.google.com/maps/search/?api=1&query=" + latitudeTexto + "," + longitudeTexto;
                        var linkMapaEmbutido = "https://www.google.com/maps?q=" + latitudeTexto + "," + longitudeTexto + "&z=17&output=embed";
                    }
                    <a class="btn btn-outline-primary btn-sm" href="@linkMapa" target="_blank" rel="noopener"
                       data-bs-toggle="modal" data-bs-target="#mapaModal"
                       data-mapa-embutido="@linkMapaEmbutido" data-mapa-nome="@oficina.Nome">Ver no mapa</a>
                </article>
            }
        </div>

        @* Janela do mapa: abre por cima do resultado. O botão "Ver no mapa" preenche o título e o endereço do mapa. *@
        <div class="modal fade ad-map-modal" id="mapaModal" tabindex="-1" aria-labelledby="mapaModalTitulo" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="mapaModalTitulo">Mapa</h2>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body p-0">
                        <iframe id="mapaModalFrame" title="Mapa da oficina" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                    </div>
                    <div class="modal-footer">
                        <a id="mapaModalLink" class="ad-text-link" href="#" target="_blank" rel="noopener">Abrir no Google Maps (rotas) ↗</a>
                    </div>
                </div>
            </div>
        </div>
    }
</section>
<div class="ad-result-actions"><a class="ad-button ad-button-primary" asp-controller="Consulta" asp-action="Criar">Fazer nova consulta <span aria-hidden="true">↗</span></a><a class="ad-text-link" asp-controller="Home" asp-action="Index">Voltar ao início</a></div>

@section Scripts {
    <script>
        // Quando a janela do mapa abre, pega os dados do botão clicado e carrega o mapa daquela oficina.
        (function () {
            var modal = document.getElementById("mapaModal");
            if (!modal) return;
            var frame = document.getElementById("mapaModalFrame");

            modal.addEventListener("show.bs.modal", function (evento) {
                var botao = evento.relatedTarget;
                document.getElementById("mapaModalTitulo").textContent = botao.getAttribute("data-mapa-nome");
                document.getElementById("mapaModalLink").href = botao.getAttribute("href");
                frame.src = botao.getAttribute("data-mapa-embutido");
            });

            // Ao fechar, limpa o mapa para não ficar carregando por trás.
            modal.addEventListener("hidden.bs.modal", function () {
                frame.src = "about:blank";
            });
        })();
    </script>
}
