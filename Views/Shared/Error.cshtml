@model ErrorViewModel
@{
    ViewData["Title"] = "Algo deu errado";
}
<section class="ad-error" aria-labelledby="error-title">
    <div class="ad-error-art" data-ad-reveal><img src="~/images/gabriel-ui/route-signal.svg" asp-append-version="true" width="420" height="260" alt="" /></div>
    <div data-ad-reveal><p class="ad-eyebrow">VAMOS RETOMAR O CAMINHO</p><h1 id="error-title">Uma pausa<br /><span class="ad-gradient-text">inesperada.</span></h1><p class="ad-lead">Não conseguimos concluir sua solicitação.<br />Tente novamente em alguns instantes.</p><a class="ad-button ad-button-primary" asp-controller="Home" asp-action="Index">Voltar para o início <span aria-hidden="true">↗</span></a>
    @if (Model.ShowRequestId)
    {
        <p class="ad-request-id">Código do erro para a equipe:<br /><code>@Model.RequestId</code></p>
    }
    </div>
</section>
